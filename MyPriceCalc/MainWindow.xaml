<Window x:Class="MyPriceCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MyPriceCalc.Controls"
        Title="mypricecalc" Height="700" Width="960" MinWidth="720" MinHeight="480"
        Background="{x:Static c:Theme.Window}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{x:Static c:Theme.Panel}"/>
            <Setter Property="BorderBrush" Value="{x:Static c:Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{x:Static c:Theme.Text}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{x:Static c:Theme.Muted}"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{x:Static c:Theme.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- Inputs -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Price" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Adjustments run top to bottom" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                    <TextBlock Text="Starting price" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="BasePriceBox" Padding="6,5" Margin="0,2,0,0" FontSize="15"/>
                </StackPanel>

                <Button x:Name="AddRowButton" DockPanel.Dock="Bottom" Content="＋  Add adjustment"
                        Style="{StaticResource Primary}" Margin="0,10,0,0" Click="AddRow_Click"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel x:Name="RowsPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Result -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TOTAL" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalText" Text="$0.00" FontSize="44" FontWeight="Bold"
                               Foreground="{x:Static c:Theme.Accent}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DeltaText" Text="—" Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                    <TextBlock Text="Rounding" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="RoundingBox" Margin="0,3,0,0" Padding="6,4" SelectionChanged="Rounding_Changed"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="CopyButton" Content="Copy summary" Padding="10,6" Click="Copy_Click"/>
                    <Button x:Name="ResetButton" Content="Reset" Padding="10,6" Margin="0,6,0,0" Click="Reset_Click"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Starting" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="BaseEchoText" Text="—" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Adjustments" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="AdjustEchoText" Text="—" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Before rounding" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="BeforeRoundingText" Text="—" FontSize="16"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
