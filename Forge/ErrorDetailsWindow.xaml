<Window x:Class="Forge.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forge — Error Diagnostics"
        Width="750" Height="520"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Session Errors:" Margin="0,0,0,4" FontWeight="Bold"/>

        <ListBox Grid.Row="1" x:Name="ErrorsListBox" SelectionChanged="ErrorsListBox_SelectionChanged" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="Gray"/>
                        <Run Text=" [" Foreground="Gray"/>
                        <Run Text="{Binding Source}" FontWeight="SemiBold"/>
                        <Run Text="] " Foreground="Gray"/>
                        <Run Text="{Binding Message}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="Error Details and Stack Trace:" Margin="0,0,0,4" FontWeight="Bold"/>

        <TextBox Grid.Row="3" x:Name="DetailsTextBox"
                 IsReadOnly="True"
                 FontFamily="Consolas, Lucida Console, Courier New, monospace"
                 FontSize="12"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Margin="0,0,0,8"/>

        <DockPanel Grid.Row="4">
            <Button x:Name="ClearButton" Content="Clear Errors" Click="ClearButton_Click" Width="100" Margin="0,0,8,0" DockPanel.Dock="Left"/>
            <Button x:Name="OpenLogButton" Content="Open Log Folder" Click="OpenLogButton_Click" Width="120" Margin="0,0,8,0" DockPanel.Dock="Left"/>
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" Width="80" DockPanel.Dock="Right"/>
            <Button x:Name="CopyButton" Content="Copy to Clipboard" Click="CopyButton_Click" Width="130" Margin="0,0,8,0" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
